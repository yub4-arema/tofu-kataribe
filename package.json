{
  "name": "tofu-kataribe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:none": "tsx watch --env-file-if-exists=.env src/provider-entry.ts none",
    "dev:local": "tsx watch --env-file-if-exists=.env src/provider-entry.ts voicevox-local",
    "dev:api": "tsx watch --env-file-if-exists=.env src/provider-entry.ts voicevox-ttsquest",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "start:none": "node --env-file-if-exists=.env dist/provider-entry.js none",
    "start:local": "node --env-file-if-exists=.env dist/provider-entry.js voicevox-local",
    "start:api": "node --env-file-if-exists=.env dist/provider-entry.js voicevox-ttsquest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --import-plugin --node-plugin --vitest-plugin --deny-warnings .",
    "lint:fix": "oxlint --fix --import-plugin --node-plugin --vitest-plugin .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "check:fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "hono": "^4.10.7",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "oxlint": "^1.30.0",
    "oxfmt": "^0.17.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
