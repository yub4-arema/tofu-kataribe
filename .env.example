# OpenAI-compatible Chat Completions endpoint and model
OPENAI_BASE_URL=http://localhost:11434/v1/chat/completions
OPENAI_MODEL=gpt-oss:20b

# Bearer authentication (OpenAI, Groq, and compatible providers)
OPENAI_API_KEY=

# Basic authentication (authenticated Ollama gateways)
# Do not set OPENAI_API_KEY when using these values.
OPENAI_BASIC_USERNAME=
OPENAI_BASIC_PASSWORD=

# Application settings
PORT=3001
SYSTEM_PROMPT=You are a concise Japanese AItuber.
API_AUTH_TOKEN=
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_TURNS=4

# Speech provider: none, voicevox-local, or voicevox-ttsquest
SPEECH_PROVIDER=none

# Local VOICEVOX settings (used when SPEECH_PROVIDER=voicevox-local)
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=1

# TTS Quest settings (used when SPEECH_PROVIDER=voicevox-ttsquest)
TTSQUEST_URL=https://api.tts.quest/v3/voicevox/synthesis
TTSQUEST_SPEAKER=3
TTSQUEST_KEY=
SPEECH_TIMEOUT_MS=120000
